@model GuevaraG_LigaPro.Models.Equipo

@{
    ViewData["Title"] = "Detalles del Equipo";
}

<h2>Detalles del Equipo</h2>

<div class="card">
    <div class="card-header">
        <h3>@Model.Nombre</h3>
    </div>
    <div class="card-body">
        <p><strong>Posición:</strong> @Model.Posicion</p>
        <p><strong>Id:</strong> @Model.Id</p>
        <p><strong>Partidos Jugados:</strong> @Model.PartidosJugados</p>
        <p><strong>Partidos Ganados:</strong> @Model.PartidosGanados</p>
        <p><strong>Partidos Empatados:</strong> @Model.PartidosEmpatados</p>
        <p><strong>Partidos Perdidos:</strong> @Model.PartidosPerdidos</p>
        <p><strong>Total de Puntos:</strong> @Model.TotalPuntos</p>
    </div>
    <div class="card-footer">
        <a class="btn btn-primary" asp-action="List">Volver a la Lista</a>
    </div>
</div>